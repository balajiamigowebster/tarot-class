# Unlimited upload body for Apache & LiteSpeed
LimitRequestBody 0

# Prevent LiteSpeed from aborting or timing out large video uploads
RewriteEngine On
RewriteRule .* - [E=noabort:1]
RewriteRule .* - [E=noconntimeout:1]

<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, HEAD"
    Header always set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization, Range"
    Header always set Access-Control-Expose-Headers "Content-Range, Accept-Ranges, Content-Length"
</IfModule>

# Handle OPTIONS preflight immediately
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

<IfModule lsapi_module>
   php_value upload_max_filesize 2048M
   php_value post_max_size 2048M
   php_value max_execution_time 7200
   php_value max_input_time 7200
   php_value memory_limit 2048M
</IfModule>

<IfModule mod_php.c>
   php_value upload_max_filesize 2048M
   php_value post_max_size 2048M
   php_value max_execution_time 7200
   php_value max_input_time 7200
   php_value memory_limit 2048M
</IfModule>

<IfModule mod_php7.c>
   php_value upload_max_filesize 2048M
   php_value post_max_size 2048M
   php_value max_execution_time 7200
   php_value max_input_time 7200
   php_value memory_limit 2048M
</IfModule>
